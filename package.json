{
  "name": "react-simple-chatbot",
  "version": "0.7.0",
  "description": "React Simple Chatbot",
  "main": "dist/react-simple-chatbot.js",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "scripts": {
    "start": "vite example --config vite.config.mts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LucasBassetti/react-simple-chatbot"
  },
  "keywords": [
    "react",
    "chat",
    "chatbot",
    "conversational-ui"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/LucasBassetti/react-simple-chatbot/issues"
  },
  "homepage": "https://github.com/LucasBassetti/react-simple-chatbot#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "styled-components": "^6.5.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "flatted": "^3.3.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "styled-components": ">=5.1.0"
  },
  "module": "dist/react-simple-chatbot.mjs",
  "sideEffects": false
}
