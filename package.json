{
  "name": "react-simple-chatbot",
  "version": "0.6.1",
  "description": "React Simple Chatbot",
  "main": "dist/react-simple-chatbot.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "scripts": {
    "lint": "eslint lib --ext .js,.jsx",
    "prepare": "npm run build",
    "start": "webpack serve --config webpack.config.js",
    "test": "mocha --require @babel/register tests/helpers/setup.js \"tests/**/*.spec.js\"",
    "test:watch": "npm test -- --watch",
    "test:coverage": "nyc npm test",
    "build": "webpack --config webpack.config.prod.js",
    "analyze": "BUNDLE_ANALYZE=true webpack --config webpack.config.prod.js",
    "test:types": "tsc -p tests/types",
    "test:dom": "mocha --require @babel/register tests/helpers/setup-dom.js tests/lib/StrictMode.spec.js tests/lib/Regressions.spec.js"
  },
  "files": [
    "dist",
    "index.d.ts"
  ],
  "nyc": {
    "function": 80,
    "lines": 80,
    "check-coverage": true,
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ],
    "extension": [
      ".jsx"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LucasBassetti/react-simple-chatbot"
  },
  "keywords": [
    "react",
    "chat",
    "chatbot",
    "conversational-ui"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/LucasBassetti/react-simple-chatbot/issues"
  },
  "homepage": "https://github.com/LucasBassetti/react-simple-chatbot#readme",
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/register": "^7.29.7",
    "@cfaester/enzyme-adapter-react-18": "^0.8.0",
    "@types/react": "^18.3.31",
    "babel-loader": "^10.1.1",
    "chai": "^4.5.0",
    "codecov": "^3.8.2",
    "enzyme": "^3.11.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "global-jsdom": "^29.0.0",
    "jsdom": "^29.1.1",
    "mocha": "^10.8.2",
    "nyc": "^18.0.0",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sinon": "^22.1.0",
    "styled-components": "^6.5.3",
    "typescript": "^7.0.2",
    "webpack": "^5.111.1",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "flatted": "^3.3.1",
    "prop-types": "^15.8.1",
    "random-id": "0.0.2"
  },
  "peerDependencies": {
    "react": ">=16.3.0",
    "react-dom": ">=16.3.0",
    "styled-components": ">=4.0.0"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12"
  }
}
